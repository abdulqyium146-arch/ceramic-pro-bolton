# ─── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX) — optional
NEXT_PUBLIC_GTM_ID=

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Production domain — used for canonical URLs and OG tags
# Must match BUSINESS.url in src/lib/business.ts
NEXT_PUBLIC_SITE_URL=https://www.ceramicpronorthwest.co.uk

# ─── Contact Form ─────────────────────────────────────────────────────────────
# Resend API key — https://resend.com (recommended)
# Wire up in src/app/api/contact/route.ts
RESEND_API_KEY=

# ─── Cloudflare Turnstile (optional bot protection) ───────────────────────────
# Site key (public, safe to expose in client code)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key (server-side only, never expose in client)
TURNSTILE_SECRET_KEY=
